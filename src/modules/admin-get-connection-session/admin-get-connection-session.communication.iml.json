[
  {
    "url": "https://api.linkedapi.io/admin/accounts.getConnectionSession",
    "method": "POST",
    "headers": {
      "linked-api-token": "{{connection.linkedApiToken}}",
      "client": "make",
      "Content-Type": "application/json"
    },
    "body": {
      "sessionId": "{{parameters.sessionId}}"
    },
    "response": {
      "valid": "{{body.success}}",
      "error": {
        "message": "{{body.error.type}}: {{body.error.message}}"
      },
      "output": "{{body.result}}"
    }
  }
]
