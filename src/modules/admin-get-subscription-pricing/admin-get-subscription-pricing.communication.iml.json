[
  {
    "url": "https://api.linkedapi.io/admin/subscription.getPricing",
    "method": "POST",
    "headers": {
      "linked-api-token": "{{connection.linkedApiToken}}",
      "client": "make",
      "Content-Type": "application/json"
    },
    "response": {
      "valid": "{{body.success}}",
      "error": {
        "message": "{{body.error.type}}: {{body.error.message}}"
      },
      "output": {
        "products": "{{body.result.products}}"
      }
    }
  }
]
