[
  {
    "name": "data",
    "type": "array",
    "label": "Search Results",
    "spec": [
      { "name": "url", "type": "url", "label": "Post URL" },
      { "name": "activityUrn", "type": "text", "label": "Activity URN" },
      { "name": "time", "type": "date", "label": "Post Time" },
      {
        "name": "type",
        "type": "select",
        "label": "Post Type",
        "options": [
          { "value": "original", "label": "Original" },
          { "value": "repost", "label": "Repost" }
        ]
      },
      {
        "name": "author",
        "type": "collection",
        "label": "Post Author",
        "spec": [
          {
            "name": "type",
            "type": "select",
            "label": "Author Type",
            "options": [
              { "value": "person", "label": "Person" },
              { "value": "company", "label": "Company" }
            ]
          },
          { "name": "name", "type": "text", "label": "Author Name" },
          { "name": "profileUrl", "type": "url", "label": "Author Profile URL" },
          { "name": "headline", "type": "text", "label": "Author Headline" },
          { "name": "companyUrl", "type": "url", "label": "Author Company URL" },
          {
            "name": "viewerState",
            "type": "collection",
            "label": "Viewer State",
            "spec": [
              {
                "name": "connectionDegree",
                "type": "select",
                "label": "Connection Degree",
                "options": [
                  { "value": "1st", "label": "1st" },
                  { "value": "2nd", "label": "2nd" },
                  { "value": "3rd+", "label": "3rd+" }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "reposter",
        "type": "collection",
        "label": "Post Reposter",
        "spec": [
          {
            "name": "type",
            "type": "select",
            "label": "Reposter Type",
            "options": [
              { "value": "person", "label": "Person" },
              { "value": "company", "label": "Company" }
            ]
          },
          { "name": "name", "type": "text", "label": "Reposter Name" },
          { "name": "profileUrl", "type": "url", "label": "Reposter Profile URL" },
          { "name": "headline", "type": "text", "label": "Reposter Headline" },
          { "name": "companyUrl", "type": "url", "label": "Reposter Company URL" }
        ]
      },
      { "name": "text", "type": "text", "label": "Post Text" },
      { "name": "repostText", "type": "text", "label": "Repost Text" },
      {
        "name": "hashtags",
        "type": "array",
        "label": "Hashtags",
        "spec": [{ "name": "hashtag", "type": "text", "label": "Hashtag" }]
      },
      {
        "name": "mentions",
        "type": "array",
        "label": "Mentions",
        "spec": [{ "name": "mentionUrl", "type": "url", "label": "Mention URL" }]
      },
      {
        "name": "externalLinks",
        "type": "array",
        "label": "External Links",
        "spec": [{ "name": "externalLinkUrl", "type": "url", "label": "External Link URL" }]
      },
      {
        "name": "images",
        "type": "array",
        "label": "Post Images",
        "spec": [{ "name": "imageUrl", "type": "url", "label": "Image URL" }]
      },
      {
        "name": "documentSlides",
        "type": "array",
        "label": "Document Slides",
        "spec": [{ "name": "documentSlideUrl", "type": "url", "label": "Document Slide URL" }]
      },
      { "name": "hasVideo", "type": "boolean", "label": "Has Video" },
      { "name": "videoThumbnail", "type": "url", "label": "Video Thumbnail" },
      { "name": "hasPoll", "type": "boolean", "label": "Has Poll" },
      { "name": "reactionsCount", "type": "number", "label": "Reactions Count" },
      { "name": "commentsCount", "type": "number", "label": "Comments Count" },
      { "name": "repostsCount", "type": "number", "label": "Reposts Count" },
      {
        "name": "viewerState",
        "type": "collection",
        "label": "Viewer State",
        "spec": [
          {
            "name": "reaction",
            "type": "select",
            "label": "Your Reaction to the Post",
            "options": [
              { "value": "like", "label": "Like" },
              { "value": "celebrate", "label": "Celebrate" },
              { "value": "support", "label": "Support" },
              { "value": "love", "label": "Love" },
              { "value": "insightful", "label": "Insightful" },
              { "value": "funny", "label": "Funny" }
            ]
          },
          { "name": "isOwn", "type": "boolean", "label": "Is Your Post" }
        ]
      }
    ]
  },
  {
    "name": "errors",
    "type": "array",
    "label": "Errors",
    "spec": [
      {
        "name": "type",
        "type": "select",
        "label": "Error Type",
        "options": [
          { "value": "filterNotApplied", "label": "Filter Not Applied" },
          { "value": "searchingNotAllowed", "label": "Searching Not Allowed" }
        ]
      },
      { "name": "message", "type": "text", "label": "Error Message" }
    ]
  }
]
