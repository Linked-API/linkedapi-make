[
  {
    "url": "/workflows",
    "method": "POST",
    "body": {
      "operationName": "searchJobs",
      "data": {
        "customSearchUrl": "{{parameters.customSearchUrl}}",
        "term": "{{parameters.searchTerm}}",
        "limit": "{{parameters.limit}}",
        "location": "{{parameters.location}}",
        "allowSimilarResults": "{{if(parameters.excludeSimilarResults, false, undefined)}}",
        "filter": {
          "datePosted": "{{parameters.datePosted}}",
          "experienceLevels": "{{if(length(parameters.experienceLevels) > 0, parameters.experienceLevels, undefined)}}",
          "employmentTypes": "{{if(length(parameters.employmentTypes) > 0, parameters.employmentTypes, undefined)}}",
          "workplaceTypes": "{{if(length(parameters.workplaceTypes) > 0, parameters.workplaceTypes, undefined)}}",
          "companies": "{{if(length(parameters.companies) > 0, parameters.companies, undefined)}}",
          "industries": "{{if(length(parameters.industries) > 0, parameters.industries, undefined)}}",
          "jobFunctions": "{{if(length(parameters.jobFunctions) > 0, parameters.jobFunctions, undefined)}}",
          "easyApply": "{{if(parameters.easyApply, true, undefined)}}",
          "hasVerifications": "{{if(parameters.hasVerifications, true, undefined)}}",
          "under10Applicants": "{{if(parameters.under10Applicants, true, undefined)}}",
          "inYourNetwork": "{{if(parameters.inYourNetwork, true, undefined)}}",
          "fairChanceEmployer": "{{if(parameters.fairChanceEmployer, true, undefined)}}"
        },
        "preferences": {
          "datePosted": "{{parameters.prefDatePosted}}",
          "experienceLevels": "{{if(length(parameters.prefExperienceLevels) > 0, parameters.prefExperienceLevels, undefined)}}",
          "employmentTypes": "{{if(length(parameters.prefEmploymentTypes) > 0, parameters.prefEmploymentTypes, undefined)}}",
          "companies": "{{if(length(parameters.prefCompanies) > 0, parameters.prefCompanies, undefined)}}",
          "remote": "{{if(parameters.prefRemote, true, undefined)}}",
          "easyApply": "{{if(parameters.prefEasyApply, true, undefined)}}",
          "under10Applicants": "{{if(parameters.prefUnder10Applicants, true, undefined)}}",
          "inYourNetwork": "{{if(parameters.prefInYourNetwork, true, undefined)}}",
          "keywords": "{{if(length(parameters.prefKeywords) > 0, parameters.prefKeywords, undefined)}}"
        }
      }
    },
    "response": {
      "temp": {
        "workflowId": "{{body.workflowId}}",
        "operationName": "searchJobs",
        "status": "{{body.status || body.workflowStatus}}",
        "message": "{{body.message}}",
        "workflowStatus": "{{body.workflowStatus || body.status}}",
        "criticalError": "{{body.criticalError}}"
      }
    }
  },
  {
    "url": "/workflows/{{temp.workflowId}}?operationName={{temp.operationName}}",
    "method": "GET",
    "repeat": {
      "condition": "{{(body.workflowStatus || body.status) === 'pending' || (body.workflowStatus || body.status) === 'running'}}",
      "delay": 5000,
      "limit": 1800
    },
    "response": {
      "temp": {
        "status": "{{body.status || body.workflowStatus}}",
        "data": "{{body.data}}",
        "errors": "{{body.errors}}",
        "message": "{{body.message}}",
        "workflowStatus": "{{body.workflowStatus || body.status}}",
        "criticalError": "{{body.criticalError}}"
      }
    }
  },
  {
    "response": {
      "valid": "{{(temp.workflowStatus || temp.status) === 'completed'}}",
      "error": {
        "message": "{{temp.criticalError.message || temp.message || 'Workflow timed out or did not complete.'}}"
      },
      "output": {
        "data": "{{temp.data}}",
        "errors": "{{temp.errors}}"
      }
    }
  }
]
