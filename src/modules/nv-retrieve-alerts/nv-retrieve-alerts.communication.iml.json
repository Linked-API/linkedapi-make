[
  {
    "url": "/workflows",
    "method": "POST",
    "body": {
      "operationName": "nvRetrieveAlerts",
      "data": {
        "limit": "{{parameters.limit}}",
        "sort": "{{parameters.sort}}",
        "filter": {
          "{{...}}": "{{omit(parameters, 'limit', 'sort', 'since')}}",
          "since": "{{if(parameters.since, formatDate(parameters.since, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), undefined)}}"
        }
      }
    },
    "response": {
      "temp": {
        "workflowId": "{{body.workflowId}}",
        "operationName": "nvRetrieveAlerts",
        "status": "{{body.status || body.workflowStatus}}",
        "message": "{{body.message}}",
        "workflowStatus": "{{body.workflowStatus || body.status}}",
        "criticalError": "{{body.criticalError}}"
      }
    }
  },
  {
    "url": "/workflows/{{temp.workflowId}}",
    "method": "GET",
    "qs": {
      "operationName": "{{temp.operationName}}"
    },
    "repeat": {
      "condition": "{{(body.workflowStatus || body.status) === 'pending' || (body.workflowStatus || body.status) === 'running'}}",
      "delay": 5000,
      "limit": 1800
    },
    "response": {
      "temp": {
        "status": "{{body.status || body.workflowStatus}}",
        "data": "{{body.data}}",
        "errors": "{{body.errors}}",
        "message": "{{body.message}}",
        "workflowStatus": "{{body.workflowStatus || body.status}}",
        "criticalError": "{{body.criticalError}}"
      }
    }
  },
  {
    "response": {
      "valid": "{{(temp.workflowStatus || temp.status) === 'completed' && length(temp.errors) === 0}}",
      "error": {
        "message": "{{if(length(temp.errors) > 0, temp.errors[1].type + ': ' + temp.errors[1].message, temp.criticalError.message || temp.message || 'Workflow timed out or did not complete.')}}"
      },
      "iterate": "{{temp.data}}",
      "output": {
        "{{...}}": "{{item}}",
        "publishedAt": "{{if(item.publishedAt, parseDate(item.publishedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), undefined)}}"
      },
      "limit": "{{parameters.limit}}"
    }
  }
]
